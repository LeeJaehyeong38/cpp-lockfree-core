# BotClient 부하테스트 설정 파일
# '#'으로 시작하는 줄은 주석으로 무시된다.

# CCU(동시접속) 단계별 테스트 목록 - 쉼표로 구분. 이 순서대로 하나씩 테스트를 돌린다.
# 예) 100,1000,5000  ->  100명 -> 1000명 -> 5000명 순서로 3단계 부하테스트
ccu_list=100,1000,5000

# 가상 클라이언트 한 명이 접속 하나당 주고받을 패킷 개수
packets_per_conn=50

# "접속 - 패킷 1개 echo - 즉시 해제"를 반복할 횟수
# (서버의 세션 재활용/프리리스트 경로를 스트레스 테스트하기 위한 반복 접속-해제 시나리오용)
repeat_iterations=2000

# ccu_list 마지막 값만큼 접속을 유지한 채로 몇 초 동안 계속 패킷을 주고받을지 (0이면 건너뜀)
# 순간 CCU 테스트는 접속하자마자 끝나버려서 실제로 부하가 걸리는 모습을 보기 어려운데,
# 이 단계는 접속을 끊지 않고 지속적으로 트래픽을 흘려보내면서 1초마다 진행 상황을 출력한다
sustain_seconds=15
